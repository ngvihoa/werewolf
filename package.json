{
  "name": "werewolf",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3001 --host",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check . && eslint && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:purge": "node scripts/db-purge.mjs",
    "db:studio": "drizzle-kit studio",
    "env:pull": "mkdir -p .vercel-cli && cd .vercel-cli && ([ -f .vercel/project.json ] || pnpm dlx vercel link) && pnpm dlx vercel env pull ../.env --environment=production",
    "dev:reset": "fuser -k 3000/tcp"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@orpc/client": "^1.14.15",
    "@orpc/contract": "1.14.15",
    "@orpc/server": "^1.14.15",
    "@orpc/tanstack-query": "^1.14.15",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.23",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.40",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "13.1.1",
    "lucide-react": "^1.31.0",
    "nitro": "3.0.260610-beta",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ngvihoa/eslint-config-best-practices": "^0.1.2",
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "supabase": "^2.114.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
